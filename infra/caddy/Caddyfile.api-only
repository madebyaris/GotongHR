# API-only origin behind Cloudflare.
# TLS is the Cloudflare Origin Certificate. Authenticated Origin Pulls checks the
# client certificate. The peer must also be in the Cloudflare IP list.
# Lists fetched 2026-11-25 from https://www.cloudflare.com/ips-v4 and /ips-v6.
# CA: https://developers.cloudflare.com/ssl/static/authenticated_origin_pull_ca.pem
# The global CA is shared by every Cloudflare account. It expires 2029-11-01.
{
	admin off
	auto_https disable_certs
	servers {
		protocols h1 h2
		# cidr-list: trusted_proxies
		trusted_proxies static \
			173.245.48.0/20 \
			103.21.244.0/22 \
			103.22.200.0/22 \
			103.31.4.0/22 \
			141.101.64.0/18 \
			108.162.192.0/18 \
			190.93.240.0/20 \
			188.114.96.0/20 \
			197.234.240.0/22 \
			198.41.128.0/17 \
			162.158.0.0/15 \
			104.16.0.0/13 \
			104.24.0.0/14 \
			172.64.0.0/13 \
			131.0.72.0/22 \
			2400:cb00::/32 \
			2606:4700::/32 \
			2803:f800::/32 \
			2405:b500::/32 \
			2405:8100::/32 \
			2a06:98c0::/29 \
			2c0f:f248::/32
		# cidr-end: trusted_proxies
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		protocols tls1.2 tls1.3
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
		}
	}

	# cidr-list: remote_ip
	@not_cloudflare not remote_ip \
		173.245.48.0/20 \
		103.21.244.0/22 \
		103.22.200.0/22 \
		103.31.4.0/22 \
		141.101.64.0/18 \
		108.162.192.0/18 \
		190.93.240.0/20 \
		188.114.96.0/20 \
		197.234.240.0/22 \
		198.41.128.0/17 \
		162.158.0.0/15 \
		104.16.0.0/13 \
		104.24.0.0/14 \
		172.64.0.0/13 \
		131.0.72.0/22 \
		2400:cb00::/32 \
		2606:4700::/32 \
		2803:f800::/32 \
		2405:b500::/32 \
		2405:8100::/32 \
		2a06:98c0::/29 \
		2c0f:f248::/32
	# cidr-end: remote_ip

	@api path /api /api/*

	route {
		handle @not_cloudflare {
			respond "Forbidden" 403
		}

		handle @api {
			uri strip_prefix /api
			encode zstd gzip
			reverse_proxy api:3000 {
				header_up -X-Forwarded-For
				header_up -Forwarded
				header_up -X-Real-IP
				header_up -True-Client-IP
				header_up -X-Client-IP
				header_up -X-Forwarded-Host
				header_up -X-Forwarded-Proto
				header_up -CF-Connecting-IP
				header_up CF-Connecting-IP {client_ip}
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-Host {http.request.host}
			}
		}

		handle {
			respond "Not found" 404
		}
	}
}

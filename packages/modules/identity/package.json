{
  "name": "@gotonghr/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm --filter @gotonghr/contracts build && pnpm --filter @gotonghr/db build",
    "test": "node --experimental-strip-types --test --test-reporter spec src/*.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.28",
    "@fastify/rate-limit": "11.3.0",
    "@gotonghr/contracts": "workspace:*",
    "@gotonghr/db": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-better-auth": "1.2.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.6",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "typescript": "5.9.3"
  }
}

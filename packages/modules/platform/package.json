{
  "name": "@gotonghr/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm --filter @gotonghr/contracts build && pnpm --filter @gotonghr/db build",
    "test": "node --experimental-strip-types --test --test-concurrency=1 --test-reporter spec src/env.test.ts src/schema.test.ts src/tokens.test.ts"
  },
  "dependencies": {
    "@gotonghr/contracts": "workspace:*",
    "@gotonghr/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gotonghr/ai": "workspace:*",
    "@gotonghr/attendance": "workspace:*",
    "@gotonghr/audit": "workspace:*",
    "@gotonghr/core-hr": "workspace:*",
    "@gotonghr/crypto": "workspace:*",
    "@gotonghr/identity": "workspace:*",
    "@types/node": "22.20.6",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "typescript": "5.9.3"
  }
}

{
  "name": "@gotonghr/payroll-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @gotonghr/contracts build",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/tables && cp src/tables/*.json dist/tables/",
    "pretypecheck": "pnpm --filter @gotonghr/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "pnpm --filter @gotonghr/contracts build",
    "test": "node --experimental-strip-types --test --test-reporter spec src/__tests__/*.test.ts",
    "pretest:invariants": "pnpm --filter @gotonghr/contracts build",
    "test:invariants": "node --experimental-strip-types --test --test-reporter spec src/__tests__/invariants.test.ts",
    "pretest:golden": "pnpm --filter @gotonghr/contracts build",
    "test:golden": "node --experimental-strip-types --test --test-reporter spec src/__tests__/golden.test.ts"
  },
  "dependencies": {
    "@gotonghr/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.6",
    "eslint": "10.15.0",
    "fast-check": "3.23.2",
    "typescript": "5.9.3"
  }
}

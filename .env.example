# Local-only placeholders. Replace STORAGE_LOCAL_SECRET with at least 32 random characters before use.
# NODE_ENV=production refuses the database passwords below.
# Compose does not invent these values.
POSTGRES_PASSWORD=change-me
MIGRATOR_PASSWORD=change-me-migrator
APP_PASSWORD=change-me-app
PLATFORM_PASSWORD=change-me-platform
QUEUE_PASSWORD=change-me-queue

# Host-side URLs for pnpm test. Compose builds its own URLs from the passwords above.
DATABASE_URL_SUPERUSER=postgres://postgres:change-me@127.0.0.1:5432/gotonghr
DATABASE_URL_MIGRATOR=postgres://gotong_migrator:change-me-migrator@127.0.0.1:5432/gotonghr
DATABASE_URL_APP=postgres://app_tenant:change-me-app@127.0.0.1:5432/gotonghr
DATABASE_URL_PLATFORM=postgres://platform_admin:change-me-platform@127.0.0.1:5432/gotonghr
DATABASE_URL_QUEUE=postgres://gotong_queue:change-me-queue@127.0.0.1:5432/gotonghr

GOTONG_ROLE=monolith
GOTONG_DEPLOYMENT_MODE=single_tenant
STORAGE_DRIVER=local
QUEUE_DRIVER=pgboss
STORAGE_LOCAL_SECRET=replace-with-a-long-random-string

# At least 32 characters. NODE_ENV=production refuses this placeholder.
BETTER_AUTH_SECRET=gotonghr-dev-auth-secret-0123456789abcdef
BETTER_AUTH_URL=http://127.0.0.1:3000
# Bootstrap password must be at least 12 characters. Production refuses this placeholder.
GOTONG_BOOTSTRAP_EMAIL=owner@gotonghr.local
GOTONG_BOOTSTRAP_PASSWORD=change-me-owner-password
GOTONG_BOOTSTRAP_TENANT_NAME=GotongHR
GOTONG_BOOTSTRAP_OWNER_NAME=Owner

# Optional, only when STORAGE_DRIVER=s3. Set both keys, or neither.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

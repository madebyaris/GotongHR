# HTTP on port 8080 inside the container. Compose publishes it as port 80.
# TLS waits until a hostname exists. Phase 0 checks the shell and /api/readyz over HTTP.
{
	admin off
}

:8080 {
	handle_path /api/* {
		encode zstd gzip
		reverse_proxy api:3000
	}

	handle /assets/* {
		root * /srv
		try_files {path}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}

{
  "name": "@gotonghr/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @gotonghr/contracts build && pnpm --filter @gotonghr/ui build && vite build && node scripts/build-ess-sw.mjs && node scripts/bundle-budget.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test": "node --test scripts/bundle-budget.test.mjs && node --experimental-strip-types --test --test-reporter spec scripts/ess-policy.test.ts worker/*.test.ts",
    "preview": "vite preview",
    "deploy": "pnpm typecheck && pnpm test && pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@gotonghr/contracts": "workspace:*",
    "@gotonghr/ui": "workspace:*",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.80.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-compression2": "2.5.4",
    "workbox-build": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "4.168.0"
  }
}

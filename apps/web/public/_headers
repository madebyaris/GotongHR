# Workers Static Assets reads this file from dist and does not serve it.
# A later rule replaces Cache-Control. Detach first so the two values are not joined.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/index.html
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/api
  ! Cache-Control
  Cache-Control: private, no-store

/api/*
  ! Cache-Control
  Cache-Control: private, no-store

/auth
  ! Cache-Control
  Cache-Control: private, no-store

/auth/*
  ! Cache-Control
  Cache-Control: private, no-store
